{
  "name": "@recursica/adapter-angular-material",
  "description": "Reusable UI components for Recursica applications based on Angular Material 20+",
  "private": false,
  "homepage": "https://github.com/borderux/recursica-adapter-angular-material",
  "author": "hi@borderux.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/borderux/recursica-adapter-angular-material/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borderux/recursica-adapter-angular-material.git"
  },
  "version": "0.9.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/fesm2022/recursica-adapter-angular-material.mjs",
  "module": "./dist/fesm2022/recursica-adapter-angular-material.mjs",
  "types": "./dist/index.d.ts",
  "keywords": [
    "angular",
    "ui",
    "ui-kit",
    "components",
    "typescript",
    "material",
    "recursica",
    "design system",
    "design systems"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/fesm2022/recursica-adapter-angular-material.mjs"
    },
    "./*.css": {
      "style": "./dist/*.css",
      "default": "./dist/*.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/PHILOSOPHY.md",
    "CHANGELOG.md",
    "llms.txt",
    "USAGE.md",
    "ARCHITECTURE.md",
    "SETUP.md",
    "OVERSTYLING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ng": "ng",
    "dev": "npm run storybook",
    "build": "cross-env NODE_ENV=production node scripts/sync-lib-version.mjs && cross-env NODE_ENV=production ng build adapter-angular-material",
    "lint": "eslint .",
    "analyze-tokens": "analyze-tokens --framework angular --css ./recursica_variables_scoped.css --dir projects/adapter-angular-material/src/lib --output token-analysis.json",
    "validate-adapter-status": "node scripts/validate-adapter-status.mjs",
    "check-types": "tsc --noEmit -p projects/adapter-angular-material/tsconfig.lib.json",
    "format": "prettier --write \"**/*.{js,ts,json,md,css,scss,html}\"",
    "prepare": "node .husky/install.mjs",
    "version": "changeset version",
    "release": "changeset publish",
    "storybook": "ng run adapter-angular-material:storybook",
    "build-storybook": "ng run adapter-angular-material:build-storybook",
    "adapter-tester": "adapter-tester --serve",
    "adapter-tester:automated": "adapter-tester",
    "adapter-tester:source-of-truth": "adapter-tester --divergence-only"
  },
  "peerDependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.0.0 || ^21.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0",
    "@angular/forms": "^20.0.0 || ^21.0.0",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.0.0 || ^21.0.0",
    "@angular/router": "^20.0.0 || ^21.0.0",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "dependencies": {
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.28",
    "@angular/build": "^22.2.4",
    "@angular/cdk": "22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-browser-dynamic": "^20.3.16",
    "@angular/router": "^22.2.3",
    "@changesets/cli": "^3.0.3",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@recursica/adapter-tester": "^5.4.0",
    "@recursica/recursica-postcss-vars": "^1.5.0",
    "@recursica/token-analyzer": "^1.9.0",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-onboarding": "10.6.3",
    "@storybook/angular": "10.6.3",
    "@types/node": "^26.6.5",
    "angular-eslint": "^22.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-storybook": "10.6.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.5",
    "prettier": "3.9.10",
    "rxjs": "~7.8.0",
    "storybook": "10.6.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.30.1",
    "zone.js": "^0.16.3"
  }
}
