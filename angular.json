{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "adapter-angular-material": {
      "projectType": "library",
      "root": "projects/adapter-angular-material",
      "sourceRoot": "projects/adapter-angular-material/src",
      "prefix": "rec",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/adapter-angular-material/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/adapter-angular-material/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/adapter-angular-material/.storybook",
            "browserTarget": "adapter-angular-material:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/adapter-angular-material"
            ],
            "port": 6006,
            "styles": [
              "recursica_variables_scoped.css",
              "projects/adapter-angular-material/src/lib/tooltip/tooltip-overlay.css",
              "projects/adapter-angular-material/src/lib/menu/menu-overlay.css",
              "projects/adapter-angular-material/src/lib/dropdown/dropdown-overlay.css",
              "projects/adapter-angular-material/src/lib/date-picker/date-picker-overlay.css",
              "projects/adapter-angular-material/src/lib/auto-complete/auto-complete-overlay.css",
              "projects/adapter-angular-material/src/lib/hover-card/hover-card-overlay.css",
              "projects/adapter-angular-material/src/lib/modal/modal-overlay.css",
              "projects/adapter-angular-material/src/lib/panel/panel-overlay.css",
              "projects/adapter-angular-material/src/lib/popover/popover-overlay.css"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/adapter-angular-material/.storybook",
            "browserTarget": "adapter-angular-material:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/adapter-angular-material"
            ],
            "outputDir": "storybook-static",
            "styles": [
              "recursica_variables_scoped.css",
              "projects/adapter-angular-material/src/lib/tooltip/tooltip-overlay.css",
              "projects/adapter-angular-material/src/lib/menu/menu-overlay.css",
              "projects/adapter-angular-material/src/lib/dropdown/dropdown-overlay.css",
              "projects/adapter-angular-material/src/lib/date-picker/date-picker-overlay.css",
              "projects/adapter-angular-material/src/lib/auto-complete/auto-complete-overlay.css",
              "projects/adapter-angular-material/src/lib/hover-card/hover-card-overlay.css",
              "projects/adapter-angular-material/src/lib/modal/modal-overlay.css",
              "projects/adapter-angular-material/src/lib/panel/panel-overlay.css",
              "projects/adapter-angular-material/src/lib/popover/popover-overlay.css"
            ]
          }
        }
      }
    }
  }
}
