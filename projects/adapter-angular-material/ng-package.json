{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "tooltip-overlay.css",
      "input": "src/lib/tooltip",
      "output": "/"
    },
    {
      "glob": "menu-overlay.css",
      "input": "src/lib/menu",
      "output": "/"
    },
    {
      "glob": "dropdown-overlay.css",
      "input": "src/lib/dropdown",
      "output": "/"
    },
    {
      "glob": "date-picker-overlay.css",
      "input": "src/lib/date-picker",
      "output": "/"
    },
    {
      "glob": "auto-complete-overlay.css",
      "input": "src/lib/auto-complete",
      "output": "/"
    },
    {
      "glob": "hover-card-overlay.css",
      "input": "src/lib/hover-card",
      "output": "/"
    },
    {
      "glob": "modal-overlay.css",
      "input": "src/lib/modal",
      "output": "/"
    },
    {
      "glob": "panel-overlay.css",
      "input": "src/lib/panel",
      "output": "/"
    },
    {
      "glob": "popover-overlay.css",
      "input": "src/lib/popover",
      "output": "/"
    }
  ]
}
